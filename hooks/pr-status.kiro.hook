{
  "name": "Check PR Status",
  "version": "2.0.0",
  "description": "Shows status of all open PRs for the current repository including review status, CI checks, and linked issues.",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "List all open pull requests for the current repository. First run 'git remote get-url origin' to detect owner/repo. Then use list_pull_requests to get all open PRs. For each PR, use get_pull_request_status to show: title, author, review status, CI check results, and whether it's mergeable."
  }
}
