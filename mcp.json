{
  "mcpServers": {
    "github-projects": {
      "command": "node",
      "args": ["server/dist/index.js"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "disabled": false,
      "autoApprove": [
        "list_projects",
        "get_project",
        "get_project_items",
        "get_status_options",
        "get_project_fields",
        "list_views",
        "list_workflows",
        "list_iterations",
        "get_project_stats",
        "get_iteration_burndown",
        "get_stale_items",
        "get_cache_status",
        "list_pull_requests",
        "get_pull_request",
        "list_issues",
        "list_branches",
        "get_repository",
        "list_pr_comments",
        "get_pr_comment",
        "list_pr_review_comments",
        "create_pr_comment",
        "create_pr_review_comment",
        "reply_to_pr_review_comment"
      ]
    }
  }
}