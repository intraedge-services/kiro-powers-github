{
  "name": "@kiro-powers/github-projects-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for GitHub Projects V2 management via GraphQL API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "webhook": "node dist/webhook/listener.js",
    "webhook:dev": "tsx src/webhook/listener.ts",
    "webhook:process": "node dist/webhook/process-event.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "github",
    "projects",
    "graphql",
    "kiro"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "graphql-request": "^6.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "tsx": "^4.16.0"
  }
}
